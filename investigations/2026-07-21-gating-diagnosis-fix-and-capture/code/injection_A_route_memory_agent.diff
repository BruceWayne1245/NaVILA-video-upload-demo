+    def _reading_unreliability(self, estimate: AnchorRelocalization) -> Optional[float]:
+        """Absolute, current-INDEPENDENT unreliability score for ONE reading
+        (higher = more likely a bad ICP reading). Phase-1 hand combination of
+        dataclass-available diagnostics, validated at AUC ~0.80 offline
+        (investigations/2026-07-21-icp-reliability-signal). Returns None when a
+        required field is missing (treated as 'no basis to distrust')."""
+        inl = estimate.inlier_count
+        ratio = estimate.best_to_second_score_ratio
+        nt = estimate.near_tie_basin_count
+        conf = estimate.confidence
+        if inl is None or ratio is None or nt is None or conf is None:
+            return None
+        z = self._RELIABILITY_ZSTATS
+
+        def zz(key, v):
+            m, s = z[key]
+            return (float(v) - m) / (s if s else 1.0)
+
+        return (
+            - zz("inlier_count", inl)
+            + zz("best_to_second_score_ratio", ratio)
+            + zz("near_tie_basin_count", nt)
+            - zz("confidence", conf)
+        )
