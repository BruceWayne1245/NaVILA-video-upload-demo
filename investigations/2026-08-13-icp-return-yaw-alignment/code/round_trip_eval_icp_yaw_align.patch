+def icp_anchor_segment_return_yaw(
+    route_agent,
+    current_descriptor,
+    icp_objective,
+    voxel_size_m,
+    max_points,
+    quality_policy,
+    loftr_rear_yaw_check,
+    vision_disagreement_mode,
+    vision_disagreement_confidence_penalty,
+):
+    """Non-oracle counterpart to oracle_anchor_segment_return_yaw: estimate the
+    same "yaw to face at return start" quantity from self-driven ICP evidence
+    instead of ground-truth anchor world_pose.
+
+    Read-only / side-effect-free by construction: calls
+    relocalization.sequential_pair_anchor_relocalization directly with
+    diagnostics=None, bypassing RouteMemoryAgent.update_relocalization()'s
+    temporal-smoothing/quarantine/promotion-vote bookkeeping entirely (that
+    bookkeeping assumes one call per return-phase VLM step; calling it here,
+    before the first real VLM query, would corrupt those running stats).
+
+    route_agent.sequential_target_anchor_pair() returns (current, next) where,
+    right after finalize_outbound() (exactly when this runs), "current" is the
+    last outbound anchor -- the anchor the robot is physically standing on --
+    and "next" is the one before it, i.e. already the start-ward anchor the
+    robot should walk toward first during return. anchor_dx_m/anchor_dy_m from
+    the ICP match are each anchor's position in the robot's CURRENT body frame
+    (dx=forward, dy=left; confirmed by AnchorRelocalization.bearing_to_anchor_deg
+    = atan2(dy, dx), the same convention used by
+    oracle_true_bearing_error_to_anchor_deg elsewhere in this file). Both
+    candidates come from the same ICP call against the same current_descriptor,
+    so they share one frame/origin -- (next - current) is therefore a valid
+    body-frame vector from the current anchor's position to the next anchor's
+    position, the ICP analog of oracle_anchor_segment_return_yaw's
+    world-frame `a_xy - b_xy` (current here plays the role of that function's
+    goal-ward "b", next plays its start-ward "a", so next-current already
+    equals a-b -- no extra sign flip needed). atan2 of that vector is directly
+    the body-frame bearing to face, i.e. exactly the yaw_delta_rad the caller
+    should physically rotate by (no world-frame math involved at all).
+
+    Returns None if fewer than two anchors exist yet, or ICP fails to produce
+    a usable "next" candidate (thin/self-similar local scan right at return
+    start) -- callers must treat None as "skip the turn," mirroring how the
+    oracle path already no-ops when oracle_anchor_segment_return_yaw returns
+    None.
+    """
+    current_anchor, next_anchor = route_agent.sequential_target_anchor_pair()
+    if current_anchor is None or next_anchor is None:
+        return None
+    candidates = sequential_pair_anchor_relocalization(
+        current_descriptor,
+        current_anchor,
+        next_anchor,
+        diagnostics=None,
+        return_candidates=True,
+        icp_objective=icp_objective,
+        voxel_size_m=voxel_size_m,
+        max_points=max_points,
+        quality_policy=quality_policy,
+        loftr_rear_yaw_check=loftr_rear_yaw_check,
+        vision_disagreement_mode=vision_disagreement_mode,
+        vision_disagreement_confidence_penalty=vision_disagreement_confidence_penalty,
+    )
+    if not candidates:
+        return None
+    by_index = {candidate.anchor_index: candidate for candidate in candidates}
+    current_estimate = by_index.get(current_anchor.index)
+    next_estimate = by_index.get(next_anchor.index)
+    if next_estimate is None:
+        return None
+    # finalize_outbound() places the robot exactly on the current anchor, so a
+    # missing current-anchor match (thin scan, degenerate geometry, etc.) is
+    # expected on some episodes -- fall back to (0, 0), i.e. trust next's own
+    # bearing directly, rather than discarding the whole estimate.
+    current_dx = current_estimate.anchor_dx_m if current_estimate is not None else 0.0
+    current_dy = current_estimate.anchor_dy_m if current_estimate is not None else 0.0
+    segment_dx = next_estimate.anchor_dx_m - current_dx
+    segment_dy = next_estimate.anchor_dy_m - current_dy
+    if math.hypot(segment_dx, segment_dy) <= 1e-6:
+        return None
+    yaw_delta_rad = float(math.atan2(segment_dy, segment_dx))
+    return {
+        "yaw_delta_rad": yaw_delta_rad,
+        "yaw_delta_deg": float(math.degrees(yaw_delta_rad)),
+        "segment_anchor_indices": [int(current_anchor.index), int(next_anchor.index)],
+        "current_candidate_matched": current_estimate is not None,
+        "next_candidate_confidence": float(next_estimate.confidence),
+        "next_candidate_inlier_count": next_estimate.inlier_count,
+        "next_candidate_match_class": next_estimate.match_class,
+    }
+
+
