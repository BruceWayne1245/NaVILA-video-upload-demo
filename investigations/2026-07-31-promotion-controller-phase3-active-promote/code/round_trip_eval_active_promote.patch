=== Hunk 3: _sequential_pair_relocalizer_with_v11_shadow closure (the actual scoring) ===

@@ closure, right before promotion_shadow_pending assembly and `return result` @@
+            if active_promotion_feature_builder is not None:
+                # 2026-07-31 (Phase 3, promote/wait only): scores THIS attempt's
+                # records right now, synchronously, so route_agent can consume
+                # the decision a few lines below (inside update_relocalization's
+                # continuation, same call stack, same attempt) -- unlike
+                # promotion_shadow_pending above, this cannot be deferred to
+                # after update_return_motion() returns, the real promote
+                # decision needs it immediately. Uses its own feature-builder
+                # instance (see where it's constructed) so this never
+                # double-counts an attempt into promotion_shadow_session's
+                # rolling history.
+                active_new_records = records[record_start:]
+                route_agent._active_promotion_model_decision = None
+                if active_new_records:
+                    try:
+                        active_attempt = int(active_new_records[-1]["attempt"])
+                        active_feat = active_promotion_feature_builder.build_attempt(
+                            promotion_episode_key, active_attempt, active_new_records
+                        )
+                        if active_feat is not None:
+                            active_proba = promotion_bundle.predict_proba(active_feat)
+                            active_decision = promotion_decision_policy.decide(active_proba)
+                            # Only "promote" ever sets True -- "wait" and
+                            # "quarantine" both fall through to "do not
+                            # promote" (i.e. wait) in route_memory_agent.py;
+                            # quarantine is never allowed to touch
+                            # _quarantined_anchor_indices from here.
+                            route_agent._active_promotion_model_decision = (
+                                active_decision == "promote"
+                            )
+                    except Exception as exc:  # fail-open, mirrors PromotionShadowJsonlSession.score_attempt
+                        route_agent._active_promotion_model_decision = None
+                        print(
+                            f"[promotion-active] scoring exception at step={num_steps}, "
+                            f"falling back to heuristic bounded_evidence vote for this attempt: "
+                            f"{type(exc).__name__}: {exc}",
+                            flush=True,
+                        )
